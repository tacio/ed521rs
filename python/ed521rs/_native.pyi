from collections.abc import Sequence
from typing import Literal

from typing_extensions import Buffer  # collections.abc.Buffer from Python 3.12

Mode = Literal["strict", "ecpy"]
# List elements: PyO3 accepts bytes or bytearray there (single arguments take any buffer).
_Bytes = bytes | bytearray

__version__: str
PUBLIC_KEY_LENGTH: int
SIGNATURE_LENGTH: int

class VerifyingKey:
    def __new__(
        cls,
        public_key: Buffer,
        *,
        mode: Mode = "strict",
        precompute: bool = False,
        reject_small_order: bool = False,
    ) -> VerifyingKey: ...
    @property
    def mode(self) -> Mode: ...
    @property
    def precomputed(self) -> bool: ...
    def is_small_order(self) -> bool: ...
    def to_bytes(self) -> bytes: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def verify(self, signature: Buffer, message: Buffer) -> bool: ...
    def reason(self, signature: Buffer, message: Buffer) -> str: ...
    def verify_many(
        self, signatures: Sequence[_Bytes], messages: Sequence[_Bytes], *, threads: int = 1
    ) -> list[bool]: ...
    def reason_many(
        self, signatures: Sequence[_Bytes], messages: Sequence[_Bytes], *, threads: int = 1
    ) -> list[str]: ...
    def verify_batch(self, signatures: Sequence[_Bytes], messages: Sequence[_Bytes]) -> bool: ...
    def verify_packed(
        self, signatures: Buffer, messages: Buffer, message_length: int, *, threads: int = 1
    ) -> list[bool]: ...

def verify(
    public_key: Buffer, signature: Buffer, message: Buffer, *, mode: Mode = "strict"
) -> bool: ...
def reason(
    public_key: Buffer, signature: Buffer, message: Buffer, *, mode: Mode = "strict"
) -> str: ...
def verify_batch(
    items: Sequence[tuple[_Bytes, _Bytes, _Bytes]], *, mode: Mode = "strict"
) -> bool: ...
def backend() -> str: ...
